<%- include('layout-start', { pageTitle: 'Dashboard' }) %>

<%
  function getLengthMarker(length) {
    if ((length || 0) < 500) return '|';
    if ((length || 0) < 2000) return '||';
    return '|||';
  }
%>

<div class="dashboard">
  <div class="tabs">
    <a href="/?tab=pending" class="tab <%= tab === 'pending' ? 'active' : '' %>">
      Pending <span class="count"><%= counts.pending %></span>
    </a>
    <a href="/?tab=decided" class="tab <%= tab === 'decided' ? 'active' : '' %>">
      Decided <span class="count"><%= counts.decided %></span>
    </a>
  </div>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <p>No <%= tab %> items yet.</p>
    </div>
  <% } else { %>
    <div class="item-list">
      <% items.forEach(item => { %>
        <a href="/review/<%= item.slug %>?fromTab=<%= tab %>" class="item-card">
          <span class="item-indicator <%= item.status %>"></span>
          <div class="item-body">
            <h2 class="item-title"><%= item.title %></h2>
            <div class="item-meta">
              <span class="category"><%= item.category %></span>
              <span class="length-indicator" aria-label="Length <%= getLengthMarker(item.content_length) %>"><%= getLengthMarker(item.content_length) %></span>
              <span><%= new Date(item.created_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              <% if (item.status === 'decided') { %>
                <span class="item-decision"><%= item.decision %></span>
              <% } %>
            </div>
            <% if (item.approval_status === 'manual_required') { %>
              <p class="item-alert">Manual task follow-up required</p>
            <% } %>
            <% if (item.feedback) { %>
              <p class="item-feedback">"<%= item.feedback %>"</p>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('layout-end') %>

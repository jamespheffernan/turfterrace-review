<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Turf Review</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Libre+Franklin:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f0ece4;
      --bg-paper: #faf8f4;
      --bg-inset: #e8e2d6;
      --border: #cdc4b4;
      --border-light: #ddd6c8;
      --text: #2a2520;
      --text-secondary: #5e554a;
      --text-muted: #8c8070;
      --terracotta: #c06030;
      --red: #b83a2a;
      --red-soft: rgba(184, 58, 42, 0.08);
      --shadow: rgba(42, 37, 32, 0.06);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Libre Franklin', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    /* Paper texture */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.35;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/%3E%3C/svg%3E");
    }

    .login-card {
      background: var(--bg-paper);
      border-radius: 8px;
      padding: 48px 40px;
      width: 100%;
      max-width: 400px;
      margin: 20px;
      position: relative;
      z-index: 1;
      box-shadow:
        0 1px 3px var(--shadow),
        0 4px 20px var(--shadow);
    }

    h1 {
      font-family: 'Lora', serif;
      color: var(--text);
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 4px;
      letter-spacing: -0.02em;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.88rem;
      margin-bottom: 32px;
    }

    label {
      display: block;
      font-weight: 600;
      color: var(--text-secondary);
      font-size: 0.75rem;
      margin-bottom: 6px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    input[type="text"], input[type="password"] {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: 'Libre Franklin', sans-serif;
      font-size: 0.92rem;
      background: var(--bg);
      color: var(--text);
      outline: none;
      margin-bottom: 20px;
      transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }

    input::placeholder { color: var(--text-muted); }
    input:focus {
      border-color: var(--terracotta);
      box-shadow: 0 0 0 3px rgba(192, 96, 48, 0.1);
    }

    button {
      width: 100%;
      padding: 13px;
      background: var(--terracotta);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: 'Libre Franklin', sans-serif;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.15s;
    }

    button:hover {
      background: #a85028;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(192, 96, 48, 0.2);
    }
    button:active {
      transform: translateY(0) scale(0.98);
      transition-duration: 0.08s;
    }

    /* Login card entrance */
    @keyframes loginEnter {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .login-card {
      animation: loginEnter 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    .error {
      background: var(--red-soft);
      color: var(--red);
      padding: 12px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      margin-bottom: 20px;
      border: 1px solid rgba(184, 58, 42, 0.15);
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>Turf Review</h1>
    <p class="subtitle">Sign in to continue</p>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" autocomplete="on">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username" required autofocus>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button type="submit">Sign in</button>
    </form>
  </div>
</body>
</html>

    <span class="chat-title">💬 <span id="chatAgentLabel">Chat with Author</span></span>
    <div class="chat-header-actions">
      <button id="chatNewBtn" class="chat-btn-new" title="New Chat">🔄</button>
      <button id="chatCloseBtn" class="chat-btn-close" title="Close">&times;</button>

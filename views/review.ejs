<%- include('layout-start', { pageTitle: item.title }) %>

<article class="review-page">
  <div class="review-header">
    <div class="review-meta">
      <span class="category"><%= item.category %></span>
      <span class="date"><%= new Date(item.created_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
      <% if (item.status === 'decided') { %>
        <span class="badge badge-decided"><%= item.decision %></span>
      <% } else { %>
        <span class="badge badge-<%= item.status %>"><%= item.status %></span>
      <% } %>
    </div>
    <h1><%= item.title %></h1>
  </div>

  <% if (item.feedback) { %>
    <div class="feedback-display">
      <strong>Feedback:</strong> <%= item.feedback %>
    </div>
  <% } %>

  <% if (item.approval_status === 'manual_required') { %>
    <div class="approval-alert">⚠️ Manual task follow-up required</div>
  <% } %>

  <!-- Audio players -->
  <% if (item.tts_status === 'ready' || item.context_audio_status === 'ready') { %>
  <div class="audio-players">
    <% if (item.tts_status === 'ready') { %>
      <div class="tts-player">
        <span class="audio-label">📖 Read aloud</span>
        <audio controls preload="none">
          <source src="/tts-cache/<%= item.slug %>.mp3" type="audio/mpeg">
        </audio>
      </div>
    <% } %>
    <% if (item.context_audio_status === 'ready') { %>
      <div class="tts-player">
        <span class="audio-label">💬 Context</span>
        <audio controls preload="none">
          <source src="/audio/<%= item.slug %>-context.mp3" type="audio/mpeg">
        </audio>
      </div>
    <% } %>
  </div>
  <% } %>

  <% if (!item.markdown && (item.rendered_html.includes('<!DOCTYPE') || item.rendered_html.includes('<html'))) { %>
    <div class="rendered-content rendered-content--fullpage">
      <iframe srcdoc="<%- item.rendered_html.replace(/\"/g, '&quot;') %>" style="width:100%;min-height:80vh;border:1px solid var(--border-light);border-radius:4px;"></iframe>
    </div>
  <% } else { %>
    <div class="rendered-content">
      <%- item.rendered_html %>
    </div>
  <% } %>
</article>

<% if (item.status === 'pending') { %>
<!-- Inline action buttons after content (the original layout) -->
<div class="action-bar">
  <div class="action-form">
    <div class="action-buttons">
      <% actions.forEach(function(action, i) { %>
        <button type="button" class="btn btn-action btn-action-<%= i %>" onclick="submitDecision('<%= action.replace(/'/g, "\\'") %>')">
          <%= action %>
        </button>
      <% }); %>
    </div>
    <div class="feedback-wrapper">
      <input type="text" id="feedbackInput" placeholder="Add feedback (optional)" class="feedback-input">
    </div>
  </div>
</div>

<!-- Floating buttons: mic + decision quick-access -->
<div class="floating-buttons">
  <button type="button" id="decisionFab" class="btn-fab btn-fab-decision" onclick="toggleDecisionPanel()" title="Quick decision">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
  </button>
  <button type="button" id="micBtn" class="btn-fab btn-fab-mic" onclick="toggleDictation()" title="Dictate feedback">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
  </button>
</div>

<!-- Quick decision panel (slides up from floating button) -->
<div id="decisionPanel" class="decision-panel" style="display:none;">
  <div class="decision-panel-inner">
    <div class="decision-panel-header">
      <span>Quick Decision</span>
      <button type="button" onclick="toggleDecisionPanel()" class="decision-panel-close">✕</button>
    </div>
    <div class="decision-panel-buttons">
      <% actions.forEach(function(action, i) { %>
        <button type="button" class="btn btn-action btn-action-<%= i %>" onclick="submitDecision('<%= action.replace(/'/g, "\\'") %>')">
          <%= action %>
        </button>
      <% }); %>
    </div>
    <input type="text" id="feedbackInputPanel" placeholder="Feedback (optional)" class="feedback-input" oninput="syncFeedback(this.value)">
  </div>
</div>

<% } else { %>
<div class="action-bar action-bar--decided">
  <div class="decided-summary">
    <strong>Decision:</strong> <%= item.decision || item.status %>
    <% if (item.feedback) { %> — "<%= item.feedback %>"<% } %>
  </div>
</div>
<% } %>

<script>
  let mediaRecorder = null;
  let audioChunks = [];
  let isRecording = false;

  function syncFeedback(val) {
    const main = document.getElementById('feedbackInput');
    if (main) main.value = val;
  }

  function toggleDecisionPanel() {
    const panel = document.getElementById('decisionPanel');
    const fab = document.getElementById('decisionFab');
    if (panel.style.display === 'none') {
      panel.style.display = 'block';
      fab.classList.add('active');
      // Sync feedback from main input
      const panelInput = document.getElementById('feedbackInputPanel');
      const mainInput = document.getElementById('feedbackInput');
      if (panelInput && mainInput) panelInput.value = mainInput.value;
    } else {
      panel.style.display = 'none';
      fab.classList.remove('active');
    }
  }

  function toggleDictation() {
    if (isRecording) {
      stopRecording();
    } else {
      startRecording();
    }
  }

  async function startRecording() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
      audioChunks = [];
      mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        await transcribe(blob);
      };
      mediaRecorder.start();
      isRecording = true;
      const btn = document.getElementById('micBtn');
      btn.classList.add('listening');
    } catch (err) {
      alert('Microphone access denied');
    }
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
    isRecording = false;
    const btn = document.getElementById('micBtn');
    btn.classList.remove('listening');
    btn.classList.add('transcribing');
  }

  async function transcribe(blob) {
    const btn = document.getElementById('micBtn');
    try {
      const formData = new FormData();
      formData.append('audio', blob, 'recording.webm');
      const res = await fetch('/api/transcribe', { method: 'POST', body: formData });
      if (res.ok) {
        const data = await res.json();
        const input = document.getElementById('feedbackInput');
        const panelInput = document.getElementById('feedbackInputPanel');
        const text = data.text;
        if (input) input.value = input.value.trim() ? input.value + ' ' + text : text;
        if (panelInput) panelInput.value = input ? input.value : text;
      } else {
        const err = await res.json();
        if (window.showToast) window.showToast('Transcription failed: ' + (err.error || 'Unknown'), { error: true });
        else alert('Transcription failed: ' + (err.error || 'Unknown'));
      }
    } catch (err) {
      if (window.showToast) window.showToast('Transcription failed: ' + err.message, { error: true });
      else alert('Transcription failed: ' + err.message);
    } finally {
      btn.classList.remove('listening', 'transcribing');
    }
  }

  async function submitDecision(decision) {
    const feedback = (document.getElementById('feedbackInput') || {}).value || '';
    const slug = '<%= item.slug %>';
    document.querySelectorAll('.btn-action').forEach(b => { b.disabled = true; b.style.opacity = '0.5'; });
    try {
      const res = await fetch('/api/items/' + slug + '/decide', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision, feedback: feedback || undefined })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        if (window.showToast) window.showToast('Error: ' + (data.error || 'Unknown'), { error: true });
        else alert('Error: ' + (data.error || 'Unknown'));
        document.querySelectorAll('.btn-action').forEach(b => { b.disabled = false; b.style.opacity = '1'; });
      }
    } catch (err) {
      if (window.showToast) window.showToast('Network error', { error: true });
      else alert('Network error');
      document.querySelectorAll('.btn-action').forEach(b => { b.disabled = false; b.style.opacity = '1'; });
    }
  }
</script>

<%- include('layout-end') %>

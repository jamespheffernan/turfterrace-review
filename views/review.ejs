<%- include('layout-start', { pageTitle: item.title }) %>
<% var reviewChatEnabled = (typeof hasChat !== 'undefined') ? hasChat : true; %>
<% var chatActionNames = ['chat with author', 'chat', 'ask ai']; %>
<% var sidebarActions = (typeof actions !== 'undefined' && actions) ? actions.filter(function(a) { return chatActionNames.indexOf(a.toLowerCase()) === -1; }) : []; %>
<% var actionStatus = item.action_status || item.approval_status; %>
<% var actionMessage = item.action_message || item.approval_message; %>
<% var requestRows = (typeof decisionRequests !== 'undefined' && decisionRequests) ? decisionRequests : []; %>
<%
  function proofSummary(request) {
    if (request.last_error && ['failed', 'blocked_system', 'blocked_decision'].indexOf(request.status) !== -1) {
      return 'Error: ' + request.last_error;
    }
    if (!request.proof_json) return '';
    var proof;
    try {
      proof = JSON.parse(request.proof_json);
    } catch (_err) {
      return '';
    }
    if (!proof || typeof proof !== 'object') return '';
    if (proof.task && proof.task.id) return 'Proof: OmniFocus task ' + proof.task.id;
    if (proof.eventId) return 'Proof: Calendar event ' + proof.eventId;
    if (proof.queueItemIds && proof.queueItemIds.length) return 'Proof: send queue ' + proof.queueItemIds.join(', ');
    if (proof.sendAttemptIds && proof.sendAttemptIds.length) return 'Proof: sent email log ' + proof.sendAttemptIds.join(', ');
    if (proof.resolvedByReview) return 'Proof: resolved by ' + proof.resolvedByReview;
    if (proof.slug) return 'Proof: replacement review ' + proof.slug;
    if (proof.summary) return 'Proof: ' + proof.summary;
    if (proof.producedArtifact) return 'Proof: artifact recorded';
    return '';
  }
%>
<% if (!reviewChatEnabled && typeof actions !== 'undefined' && actions) { reviewChatEnabled = actions.some(function(a) { return chatActionNames.indexOf(a.toLowerCase()) !== -1; }); } %>
<% if (reviewChatEnabled) { %>
<link rel="stylesheet" href="/chat.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 'dev' %>">
<% } %>

<!-- Sticky back button -->
<a href="/?tab=<%= returnTab %>" class="back-btn" title="Back to queue">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  <span>Queue</span>
</a>

<div class="review-layout">
<article class="review-page">
  <div class="review-header">
    <div class="review-meta">
      <span class="category"><%= item.category %></span>
      <span class="date"><%= new Date(item.created_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
      <% if (item.status === 'decided') { %>
        <span class="badge badge-decided"><%= item.decision %></span>
      <% } else { %>
        <span class="badge badge-<%= item.status %>"><%= item.status %></span>
      <% } %>
    </div>
    <h1><%= item.title %></h1>
  </div>

  <% if (item.feedback) { %>
    <div class="feedback-display">
      <strong>Feedback:</strong> <%= item.feedback %>
    </div>
  <% } %>

  <% if (actionStatus && actionStatus !== 'succeeded') { %>
    <div class="approval-alert">
      <div>
        <strong>Action <%= actionStatus %>:</strong>
        <%= actionMessage || ('Action status: ' + actionStatus) %>
      </div>
      <% if (actionStatus === 'failed' || actionStatus === 'blocked') { %>
        <button type="button" class="approval-retry-btn" onclick="retryDecisionAction()">Retry</button>
      <% } %>
    </div>
  <% } %>

  <% if (item.status !== 'pending' && requestRows.length > 0) { %>
    <div class="feedback-display">
      <strong>Downstream:</strong>
      <ul class="decision-request-list">
        <% requestRows.forEach(function(request) { %>
          <% var proofText = proofSummary(request); %>
          <li>
            <span class="decision-request-status"><%= request.status %></span>
            <span><%= request.summary %></span>
            <% if (request.confirmation_slug) { %>
              <a href="/review/<%= request.confirmation_slug %>">follow-up review</a>
            <% } %>
            <% if (proofText) { %>
              <span class="decision-request-proof"><%= proofText %></span>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Audio players (hairline editorial) -->
  <% if (item.tts_status === 'ready' || item.context_status === 'ready') { %>
  <div class="audio-players">
    <% if (item.tts_status === 'ready') { %>
      <div class="audio-row" data-channel="readaloud">
        <button class="audio-play" type="button" aria-label="Play read aloud">
          <svg class="audio-icon audio-icon--play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2l7 4-7 4z"/></svg>
          <svg class="audio-icon audio-icon--pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="3" y="2" width="2.5" height="8"/><rect x="6.5" y="2" width="2.5" height="8"/></svg>
        </button>
        <span class="audio-label">Read aloud</span>
        <div class="audio-progress" tabindex="0" role="slider" aria-label="Read aloud progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="audio-progress-fill"></div>
        </div>
        <span class="audio-time">0:00</span>
        <audio preload="metadata">
          <source src="/tts-cache/<%= item.slug %>.mp3" type="audio/mpeg">
        </audio>
      </div>
    <% } %>
    <% if (item.context_status === 'ready') { %>
      <div class="audio-row" data-channel="context">
        <button class="audio-play" type="button" aria-label="Play context">
          <svg class="audio-icon audio-icon--play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2l7 4-7 4z"/></svg>
          <svg class="audio-icon audio-icon--pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="3" y="2" width="2.5" height="8"/><rect x="6.5" y="2" width="2.5" height="8"/></svg>
        </button>
        <span class="audio-label">Context</span>
        <div class="audio-progress" tabindex="0" role="slider" aria-label="Context progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="audio-progress-fill"></div>
        </div>
        <span class="audio-time">0:00</span>
        <audio preload="metadata">
          <source src="/audio/<%= item.slug %>.mp3" type="audio/mpeg">
        </audio>
      </div>
    <% } %>
  </div>
  <% } %>

  <% if (!item.markdown && (item.rendered_html.includes('<!DOCTYPE') || item.rendered_html.includes('<html'))) { %>
    <div class="rendered-content rendered-content--fullpage">
      <iframe srcdoc="<%- item.rendered_html.replace(/\"/g, '&quot;') %>" style="width:100%;min-height:80vh;border:1px solid var(--border-light);border-radius:4px;"></iframe>
    </div>
  <% } else { %>
    <div class="rendered-content">
      <%- item.rendered_html %>
    </div>
  <% } %>
</article>

<% if (item.status === 'pending') { %>
<!-- Desktop: sticky sidebar -->
<aside class="action-sidebar" id="reviewSidebar">
  <div class="action-sidebar-inner">
    <% if (reviewChatEnabled) { %>
    <div class="sidebar-toggle-row">
      <div class="sidebar-toggle">
        <button class="sidebar-toggle-btn active" id="decideTab" type="button">Decide</button>
        <button class="sidebar-toggle-btn" id="chatTab" type="button">Chat<span class="chat-dot" id="chatDot" style="display:none;"></span></button>
      </div>
      <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <% } %>

    <div class="decide-view" id="decideView">
      <div class="action-sidebar-buttons">
        <% sidebarActions.forEach(function(action, i) { %>
          <button type="button" class="btn btn-action btn-action-<%= i %>" onclick="submitDecision('<%= action.replace(/'/g, "\\'") %>')">
            <%= action %>
          </button>
        <% }); %>
      </div>
      <div class="action-sidebar-feedback">
        <label class="feedback-label" for="sidebarFeedback">Feedback</label>
        <textarea id="sidebarFeedback" placeholder="Add feedback (optional)" class="feedback-textarea" rows="4" oninput="syncAllFeedback(this.value)"></textarea>
        <button type="button" id="sidebarDictateBtn" class="sidebar-dictate-btn" onclick="toggleSidebarDictation()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
          <span>Dictate feedback</span>
        </button>
      </div>
    </div>

    <% if (reviewChatEnabled) { %>
    <div class="chat-view" id="chatView" data-slug="<%= item.slug %>">
      <div class="chat-header">
        <div class="chat-header-copy">
          <span class="chat-title">Ask about this review</span>
          <span class="chat-status" id="chatStatus">Ready when you are</span>
        </div>
        <button id="chatNewBtn" class="chat-new-btn" type="button">Refresh</button>
      </div>
      <div id="chatMessages" class="chat-messages"></div>
      <div class="chat-input-area">
        <input type="text" id="chatInput" class="chat-input" placeholder="Ask what matters, what is risky, or what to change first." aria-label="Ask about this review">
        <button id="chatSendBtn" class="chat-send" type="button" aria-label="Send chat message">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </div>
    </div>
    <% } %>
  </div>
</aside>
<button type="button" class="sidebar-overlay" id="sidebarOverlay" aria-label="Close chat panel"></button>
<% } else { %>
<!-- Desktop: decided sidebar -->
<aside class="action-sidebar" id="reviewSidebar">
  <div class="action-sidebar-inner">
    <% if (reviewChatEnabled) { %>
    <div class="sidebar-toggle-row">
      <div class="sidebar-toggle">
        <button class="sidebar-toggle-btn active" id="decideTab" type="button">Decide</button>
        <button class="sidebar-toggle-btn" id="chatTab" type="button">Chat<span class="chat-dot" id="chatDot" style="display:none;"></span></button>
      </div>
      <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <% } %>

    <div class="decide-view" id="decideView">
      <div class="decided-sidebar">
        <div class="sidebar-label">Decision</div>
        <div class="sidebar-decision"><%= item.decision || item.status %></div>
        <% if (item.feedback) { %>
          <div class="sidebar-label" style="margin-top: 16px;">Feedback</div>
          <div class="sidebar-feedback-text">"<%= item.feedback %>"</div>
        <% } %>
      </div>
    </div>

    <% if (reviewChatEnabled) { %>
    <div class="chat-view" id="chatView" data-slug="<%= item.slug %>">
      <div class="chat-header">
        <div class="chat-header-copy">
          <span class="chat-title">Ask about this review</span>
          <span class="chat-status" id="chatStatus">Ready when you are</span>
        </div>
        <button id="chatNewBtn" class="chat-new-btn" type="button">Refresh</button>
      </div>
      <div id="chatMessages" class="chat-messages"></div>
      <div class="chat-input-area">
        <input type="text" id="chatInput" class="chat-input" placeholder="Ask what matters, what is risky, or what to change first." aria-label="Ask about this review">
        <button id="chatSendBtn" class="chat-send" type="button" aria-label="Send chat message">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
      </div>
    </div>
    <% } %>
  </div>
</aside>
<button type="button" class="sidebar-overlay" id="sidebarOverlay" aria-label="Close chat panel"></button>
<% } %>
</div><!-- /.review-layout -->

<!-- Floating buttons: mic + decision quick-access + chat -->
<% if (reviewChatEnabled || item.status === 'pending') { %>
<div class="floating-buttons">
  <% if (reviewChatEnabled) { %>
  <button type="button" class="btn-fab btn-fab-chat" id="mobileChatFab" title="Chat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  </button>
  <% } %>
  <% if (item.status === 'pending') { %>
  <button type="button" id="decisionFab" class="btn-fab btn-fab-decision" onclick="toggleDecisionPanel()" title="Quick decision">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
  </button>
  <button type="button" id="micBtn" class="btn-fab btn-fab-mic" onclick="toggleDictation()" title="Dictate feedback">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
  </button>
  <% } %>
</div>
<% } %>

<!-- Quick decision panel (slides up from floating button) -->
<% if (item.status === 'pending') { %>
<div id="decisionPanel" class="decision-panel" style="display:none;">
  <div class="decision-panel-inner">
    <div class="decision-panel-header">
      <span>Quick Decision</span>
      <button type="button" onclick="toggleDecisionPanel()" class="decision-panel-close">✕</button>
    </div>
    <div class="decision-panel-buttons">
      <% sidebarActions.forEach(function(action, i) { %>
        <button type="button" class="btn btn-action btn-action-<%= i %>" onclick="submitDecision('<%= action.replace(/'/g, "\\'") %>')">
          <%= action %>
        </button>
      <% }); %>
    </div>
    <input type="text" id="feedbackInputPanel" placeholder="Feedback (optional)" class="feedback-input" oninput="syncFeedback(this.value)">
  </div>
</div>
<% } %>

<% if (item.status !== 'pending') { %>
<div class="action-bar action-bar--decided">
  <div class="decided-summary">
    <strong>Decision:</strong> <%= item.decision || item.status %>
    <% if (item.feedback) { %> — "<%= item.feedback %>"<% } %>
  </div>
</div>
<% } %>

<script>
  // Wrap tables in scrollable container
  document.querySelectorAll('.rendered-content table').forEach(function(t) {
    if (t.parentElement.classList.contains('table-wrap')) return;
    var wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    t.parentNode.insertBefore(wrap, t);
    wrap.appendChild(t);
  });

  // Hairline audio players: wire each .audio-row to its inner <audio>.
  (function initAudioPlayers() {
    function fmt(s) {
      if (!Number.isFinite(s) || s < 0) return '0:00';
      var m = Math.floor(s / 60);
      var sec = Math.floor(s % 60).toString().padStart(2, '0');
      return m + ':' + sec;
    }
    document.querySelectorAll('.audio-row').forEach(function(row) {
      var audio = row.querySelector('audio');
      var btn = row.querySelector('.audio-play');
      var progress = row.querySelector('.audio-progress');
      var fill = row.querySelector('.audio-progress-fill');
      var timeEl = row.querySelector('.audio-time');
      if (!audio || !btn || !progress || !fill || !timeEl) return;
      var duration = NaN;

      function paintTime() {
        var t = audio.currentTime || 0;
        if (!duration || !Number.isFinite(duration)) {
          timeEl.textContent = fmt(t);
        } else if (row.dataset.state === 'playing' || t > 0) {
          timeEl.textContent = fmt(t) + ' / ' + fmt(duration);
        } else {
          timeEl.textContent = fmt(duration);
        }
      }
      function paintProgress() {
        if (!duration || !Number.isFinite(duration) || duration === 0) {
          fill.style.width = '0%';
          progress.setAttribute('aria-valuenow', '0');
          return;
        }
        var pct = Math.min(100, (audio.currentTime / duration) * 100);
        fill.style.width = pct + '%';
        progress.setAttribute('aria-valuenow', String(Math.round(pct)));
      }
      function setLabel(prefix) {
        var current = btn.getAttribute('aria-label') || '';
        btn.setAttribute('aria-label', current.replace(/^(Play|Pause)\s/, prefix + ' '));
      }

      audio.addEventListener('loadedmetadata', function() {
        duration = audio.duration;
        paintTime();
        paintProgress();
      });
      audio.addEventListener('timeupdate', function() { paintProgress(); paintTime(); });
      audio.addEventListener('play', function() {
        row.dataset.state = 'playing';
        setLabel('Pause');
        document.querySelectorAll('.audio-row audio').forEach(function(other) {
          if (other !== audio && !other.paused) other.pause();
        });
        paintTime();
      });
      audio.addEventListener('pause', function() {
        row.dataset.state = 'paused';
        setLabel('Play');
        paintTime();
      });
      audio.addEventListener('ended', function() {
        row.dataset.state = 'paused';
        setLabel('Play');
        paintTime();
      });

      btn.addEventListener('click', function() {
        if (audio.paused) audio.play(); else audio.pause();
      });

      progress.addEventListener('click', function(ev) {
        if (!duration || !Number.isFinite(duration)) return;
        var rect = progress.getBoundingClientRect();
        var x = ev.clientX - rect.left;
        var pct = Math.max(0, Math.min(1, x / rect.width));
        audio.currentTime = pct * duration;
        paintProgress();
        paintTime();
      });
      progress.addEventListener('keydown', function(ev) {
        if (!duration || !Number.isFinite(duration)) return;
        var step = duration < 30 ? 1 : 5;
        if (ev.key === 'ArrowRight') {
          audio.currentTime = Math.min(duration, audio.currentTime + step); ev.preventDefault();
        } else if (ev.key === 'ArrowLeft') {
          audio.currentTime = Math.max(0, audio.currentTime - step); ev.preventDefault();
        } else if (ev.key === 'Home') {
          audio.currentTime = 0; ev.preventDefault();
        } else if (ev.key === 'End') {
          audio.currentTime = duration; ev.preventDefault();
        } else if (ev.key === ' ' || ev.key === 'Enter') {
          if (audio.paused) audio.play(); else audio.pause();
          ev.preventDefault();
        }
      });

      paintTime();
      paintProgress();
    });
  })();

  let mediaRecorder = null;
  let audioChunks = [];
  let isRecording = false;

  function syncAllFeedback(val) {
    ['feedbackInput', 'feedbackInputPanel', 'sidebarFeedback'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = val;
    });
  }

  function syncFeedback(val) {
    syncAllFeedback(val);
  }

  // Keep sidebar textarea in sync with inline input
  (function() {
    var inline = document.getElementById('feedbackInput');
    var sidebar = document.getElementById('sidebarFeedback');
    if (inline) inline.addEventListener('input', function() { syncAllFeedback(this.value); });
    if (sidebar) sidebar.addEventListener('input', function() { syncAllFeedback(this.value); });
  })();

  function toggleDecisionPanel() {
    const panel = document.getElementById('decisionPanel');
    const fab = document.getElementById('decisionFab');
    if (panel.style.display === 'none') {
      panel.style.display = 'block';
      fab.classList.add('active');
      // Sync feedback from main input
      const panelInput = document.getElementById('feedbackInputPanel');
      const mainInput = document.getElementById('feedbackInput');
      if (panelInput && mainInput) panelInput.value = mainInput.value;
    } else {
      panel.style.display = 'none';
      fab.classList.remove('active');
    }
  }

  function toggleDictation() {
    if (isRecording) {
      stopRecording();
    } else {
      startRecording();
    }
  }

  async function startRecording() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
      audioChunks = [];
      mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        await transcribe(blob);
      };
      mediaRecorder.start();
      isRecording = true;
      const btn = document.getElementById('micBtn');
      btn.classList.add('listening');
    } catch (err) {
      alert('Microphone access denied');
    }
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
    isRecording = false;
    const btn = document.getElementById('micBtn');
    btn.classList.remove('listening');
    btn.classList.add('transcribing');
  }

  async function transcribe(blob) {
    const btn = document.getElementById('micBtn');
    try {
      const formData = new FormData();
      formData.append('audio', blob, 'recording.webm');
      const res = await fetch('/api/transcribe', { method: 'POST', body: formData });
      if (res.ok) {
        const data = await res.json();
        const input = document.getElementById('feedbackInput');
        const panelInput = document.getElementById('feedbackInputPanel');
        const text = data.text;
        if (input) input.value = input.value.trim() ? input.value + ' ' + text : text;
        if (panelInput) panelInput.value = input ? input.value : text;
      } else {
        const err = await res.json();
        if (window.showToast) window.showToast('Transcription failed: ' + (err.error || 'Unknown'), { error: true });
        else alert('Transcription failed: ' + (err.error || 'Unknown'));
      }
    } catch (err) {
      if (window.showToast) window.showToast('Transcription failed: ' + err.message, { error: true });
      else alert('Transcription failed: ' + err.message);
    } finally {
      btn.classList.remove('listening', 'transcribing');
    }
  }

  /* === Sidebar Dictate Button === */
  function toggleSidebarDictation() {
    const btn = document.getElementById('sidebarDictateBtn');
    if (!btn) return;
    if (isRecording) {
      stopSidebarRecording();
    } else {
      startSidebarRecording();
    }
  }

  async function startSidebarRecording() {
    const btn = document.getElementById('sidebarDictateBtn');
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
      audioChunks = [];
      mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        await transcribeSidebar(blob);
      };
      mediaRecorder.start();
      isRecording = true;
      btn.classList.add('listening');
      btn.querySelector('span').textContent = 'Listening\u2026';
    } catch (err) {
      alert('Microphone access denied');
    }
  }

  function stopSidebarRecording() {
    const btn = document.getElementById('sidebarDictateBtn');
    if (mediaRecorder && mediaRecorder.state === 'recording') mediaRecorder.stop();
    isRecording = false;
    btn.classList.remove('listening');
    btn.classList.add('transcribing');
    btn.querySelector('span').textContent = 'Transcribing\u2026';
  }

  async function transcribeSidebar(blob) {
    const btn = document.getElementById('sidebarDictateBtn');
    try {
      const formData = new FormData();
      formData.append('audio', blob, 'recording.webm');
      const res = await fetch('/api/transcribe', { method: 'POST', body: formData });
      if (res.ok) {
        const data = await res.json();
        const textarea = document.getElementById('sidebarFeedback');
        if (textarea) {
          textarea.value = textarea.value.trim() ? textarea.value + ' ' + data.text : data.text;
          syncAllFeedback(textarea.value);
        }
      } else {
        const err = await res.json();
        if (window.showToast) window.showToast('Transcription failed: ' + (err.error || 'Unknown'), { error: true });
        else alert('Transcription failed: ' + (err.error || 'Unknown'));
      }
    } catch (err) {
      if (window.showToast) window.showToast('Transcription failed: ' + err.message, { error: true });
      else alert('Transcription failed: ' + err.message);
    } finally {
      btn.classList.remove('listening', 'transcribing');
      btn.querySelector('span').textContent = 'Dictate feedback';
    }
  }

  /* === Annotation Frontend === */
  const SLUG = '<%= item.slug %>';
  let activePopover = null;
  let activeTooltip = null;
  let activeDetail = null;
  let speechRec = null;

  function dismissAnnotationUI() {
    if (activePopover) { activePopover.remove(); activePopover = null; }
    if (activeTooltip) { activeTooltip.remove(); activeTooltip = null; }
    if (activeDetail) { activeDetail.remove(); activeDetail = null; }
    if (speechRec) { try { speechRec.abort(); } catch(e){} speechRec = null; }
  }

  // -- Load existing annotations on page load --
  async function loadAnnotations() {
    try {
      const res = await fetch('/api/items/' + SLUG + '/annotations');
      if (!res.ok) return;
      const annotations = await res.json();
      annotations.forEach(renderAnnotation);
    } catch(e) { /* silent */ }
  }

  function renderAnnotation(ann) {
    if (ann.image_data) {
      renderStandaloneImageAnnotation(ann);
    } else if (ann.anchor_type === 'text') {
      highlightText(ann);
    } else if (ann.anchor_type === 'image') {
      renderImageAnnotation(ann);
    }
  }

  // -- Text highlight --
  function highlightText(ann) {
    const container = document.querySelector('.rendered-content:not(.rendered-content--fullpage)');
    if (!container) return;
    const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
    let node;
    while ((node = walker.nextNode())) {
      const idx = node.textContent.indexOf(ann.quote);
      if (idx === -1) continue;
      const range = document.createRange();
      range.setStart(node, idx);
      range.setEnd(node, idx + ann.quote.length);
      const mark = document.createElement('mark');
      mark.className = 'annotation-highlight';
      mark.dataset.annotationId = ann.id;
      mark.dataset.comment = ann.comment || '';
      mark.dataset.createdAt = ann.created_at || '';
      range.surroundContents(mark);
      break;
    }
  }

  // -- Image annotations --
  function renderImageAnnotation(ann) {
    const container = document.querySelector('.rendered-content:not(.rendered-content--fullpage)');
    if (!container) return;
    const imgs = container.querySelectorAll('img');
    imgs.forEach(function(img) {
      if (ann.anchor_ref && img.src.indexOf(ann.anchor_ref.replace('img:', '')) === -1) return;
      const wrap = ensureImgWrap(img);
      // Add or update badge
      let badge = wrap.querySelector('.img-annotation-badge');
      if (!badge) {
        badge = document.createElement('div');
        badge.className = 'img-annotation-badge';
        badge.dataset.annotations = '[]';
        wrap.appendChild(badge);
      }
      const existing = JSON.parse(badge.dataset.annotations);
      existing.push(ann);
      badge.dataset.annotations = JSON.stringify(existing);
      badge.textContent = existing.length;
      badge.onclick = function(e) { e.stopPropagation(); showImgAnnotationList(badge, existing); };
    });
  }

  function renderStandaloneImageAnnotation(ann) {
    const container = document.querySelector('.rendered-content:not(.rendered-content--fullpage)');
    if (!container || container.querySelector('[data-pencil-annotation-id="' + ann.id + '"]')) return;
    const card = document.createElement('div');
    card.className = 'pencil-annotation-card';
    card.dataset.pencilAnnotationId = ann.id;
    const mime = ann.image_mime || 'image/png';
    card.innerHTML = '<div class="pencil-annotation-card__label">Apple Pencil note</div>' +
      '<img alt="Apple Pencil annotation" src="data:' + escapeHtml(mime) + ';base64,' + ann.image_data + '">' +
      '<p>' + escapeHtml(ann.comment || '') + '</p>' +
      '<button class="pencil-annotation-card__delete" type="button">Delete</button>';
    card.querySelector('.pencil-annotation-card__delete').onclick = function(e) {
      e.stopPropagation();
      deleteAnnotation(ann.id).then(function() { card.remove(); });
    };
    container.insertBefore(card, container.firstChild);
  }

  function ensureImgWrap(img) {
    if (img.parentElement.classList.contains('img-annotation-wrap')) return img.parentElement;
    const wrap = document.createElement('span');
    wrap.className = 'img-annotation-wrap';
    img.parentElement.insertBefore(wrap, img);
    wrap.appendChild(img);
    // Add annotate button
    const btn = document.createElement('button');
    btn.className = 'img-annotate-btn';
    btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>';
    btn.onclick = function(e) { e.stopPropagation(); showImagePopover(btn, img); };
    wrap.appendChild(btn);
    return wrap;
  }

  function showImgAnnotationList(badge, annotations) {
    dismissAnnotationUI();
    const list = document.createElement('div');
    list.className = 'img-annotation-list';
    annotations.forEach(function(ann) {
      const item = document.createElement('div');
      item.className = 'img-annotation-list-item';
      item.innerHTML = '<span class="img-annotation-list-comment">' + escapeHtml(ann.comment || '') + '</span>' +
        '<button class="img-annotation-list-delete" title="Delete">\u00d7</button>';
      item.querySelector('.img-annotation-list-delete').onclick = function(e) {
        e.stopPropagation();
        deleteAnnotation(ann.id).then(function() { item.remove(); });
      };
      list.appendChild(item);
    });
    badge.parentElement.appendChild(list);
    activeDetail = list;
    setTimeout(function() {
      document.addEventListener('click', function handler() {
        if (list.parentElement) list.remove();
        activeDetail = null;
        document.removeEventListener('click', handler);
      }, { once: true });
    }, 0);
  }

  function showImagePopover(anchorBtn, img) {
    dismissAnnotationUI();
    const rect = anchorBtn.getBoundingClientRect();
    const pop = createPopover();
    pop.style.top = (rect.bottom + window.scrollY + 4) + 'px';
    pop.style.left = (rect.right + window.scrollX - 300) + 'px';
    document.body.appendChild(pop);
    activePopover = pop;
    const input = pop.querySelector('input[type="text"]');
    input.focus();
    const isMobile = window.innerWidth < 900;
    if (!isMobile && isAutoTranscribeEnabled()) startSpeechRecognition(input, pop);
    setupPopoverHandlers(pop, input, function(comment) {
      const anchor_ref = 'img:' + (img.getAttribute('src') || '');
      return submitAnnotation('', 'image', anchor_ref, comment);
    });
  }

  // -- Text selection → popover --
  (function() {
    const container = document.querySelector('.rendered-content:not(.rendered-content--fullpage)');
    if (!container) return;
    function handleTextSelection(e) {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.toString().trim()) return;
      // Don't open if clicking on an existing highlight
      if (e.target && e.target.closest && e.target.closest('.annotation-highlight')) return;
      const quote = sel.toString().trim();
      const range = sel.getRangeAt(0);
      const rect = range.getBoundingClientRect();
      dismissAnnotationUI();
      const pop = createPopover();
      pop.style.top = (rect.bottom + window.scrollY + 6) + 'px';
      pop.style.left = Math.max(8, rect.left + window.scrollX + (rect.width / 2) - 150) + 'px';
      document.body.appendChild(pop);
      activePopover = pop;
      const input = pop.querySelector('input[type="text"]');
      input.focus();
      // Compute char offset
      const offset = getCharOffset(container, range);
      const isMobile = window.innerWidth < 900;
      if (!isMobile && isAutoTranscribeEnabled()) startSpeechRecognition(input, pop);
      setupPopoverHandlers(pop, input, function(comment) {
        sel.removeAllRanges();
        return submitAnnotation(quote, 'text', 'char:' + offset, comment);
      });
    }
    container.addEventListener('mouseup', handleTextSelection);
    // Mobile: touchend after selection
    let touchSelTimer = null;
    container.addEventListener('touchend', function(e) {
      clearTimeout(touchSelTimer);
      // Delay slightly to let mobile selection settle
      touchSelTimer = setTimeout(function() { handleTextSelection(e); }, 300);
    });

    // Click on existing highlight → detail
    container.addEventListener('click', function(e) {
      const mark = e.target.closest('.annotation-highlight');
      if (!mark) return;
      dismissAnnotationUI();
      const rect = mark.getBoundingClientRect();
      const detail = document.createElement('div');
      detail.className = 'annotation-detail';
      detail.style.top = (rect.bottom + window.scrollY + 4) + 'px';
      detail.style.left = Math.max(8, rect.left + window.scrollX) + 'px';
      const dateStr = mark.dataset.createdAt ? new Date(mark.dataset.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
      detail.innerHTML =
        '<div class="annotation-detail-comment">' + escapeHtml(mark.dataset.comment || '(no comment)') + '</div>' +
        '<div class="annotation-detail-meta">' +
          '<span class="annotation-detail-date">' + dateStr + '</span>' +
          '<button class="annotation-detail-delete">Delete</button>' +
        '</div>';
      detail.querySelector('.annotation-detail-delete').onclick = function() {
        deleteAnnotation(mark.dataset.annotationId).then(function() {
          // Unwrap mark
          const parent = mark.parentNode;
          while (mark.firstChild) parent.insertBefore(mark.firstChild, mark);
          mark.remove();
          detail.remove();
          activeDetail = null;
        });
      };
      document.body.appendChild(detail);
      activeDetail = detail;
      e.stopPropagation();
      setTimeout(function() {
        document.addEventListener('click', function handler(ev) {
          if (detail.contains(ev.target)) return;
          detail.remove();
          activeDetail = null;
          document.removeEventListener('click', handler);
        });
      }, 0);
    });

    // Wrap images for annotation
    container.querySelectorAll('img').forEach(function(img) {
      ensureImgWrap(img);
    });
  })();

  function isAutoTranscribeEnabled() {
    return localStorage.getItem('turf-auto-transcribe') !== 'off';
  }
  function setAutoTranscribe(on) {
    localStorage.setItem('turf-auto-transcribe', on ? 'on' : 'off');
  }

  function createPopover() {
    const pop = document.createElement('div');
    pop.className = 'annotation-popover';
    const micOn = isAutoTranscribeEnabled();
    pop.innerHTML =
      '<div class="annotation-popover-row">' +
        '<span class="mic-pulse-dot" style="display:none;"></span>' +
        '<button class="annotation-mic-toggle" title="' + (micOn ? 'Disable' : 'Enable') + ' auto-transcribe">' +
          (micOn ? '🎙️' : '🔇') +
        '</button>' +
        '<input type="text" placeholder="' + (micOn ? 'Say or type your note\u2026' : 'Type your note\u2026') + '" autocomplete="off">' +
        '<button class="annotation-popover-submit">Save</button>' +
        '<button class="annotation-popover-cancel">\u00d7</button>' +
      '</div>';
    // Wire up mic toggle
    const micBtn = pop.querySelector('.annotation-mic-toggle');
    micBtn.onclick = function(e) {
      e.stopPropagation();
      const nowOn = !isAutoTranscribeEnabled();
      setAutoTranscribe(nowOn);
      micBtn.textContent = nowOn ? '🎙️' : '🔇';
      micBtn.title = (nowOn ? 'Disable' : 'Enable') + ' auto-transcribe';
      pop.querySelector('input[type="text"]').placeholder = nowOn ? 'Say or type your note\u2026' : 'Type your note\u2026';
      if (!nowOn && speechRec) {
        try { speechRec.abort(); } catch(ex){}
        speechRec = null;
        const dot = pop.querySelector('.mic-pulse-dot');
        if (dot) dot.style.display = 'none';
      } else if (nowOn && !speechRec) {
        const input = pop.querySelector('input[type="text"]');
        startSpeechRecognition(input, pop);
      }
    };
    return pop;
  }

  function setupPopoverHandlers(pop, input, onSubmit) {
    const cancelBtn = pop.querySelector('.annotation-popover-cancel');
    const submitBtn = pop.querySelector('.annotation-popover-submit');

    cancelBtn.onclick = function() { dismissAnnotationUI(); };

    async function doSubmit() {
      const comment = input.value.trim();
      if (!comment) { input.focus(); return; }
      submitBtn.disabled = true;
      submitBtn.textContent = '\u2026';
      try {
        await onSubmit(comment);
      } finally {
        dismissAnnotationUI();
      }
    }

    submitBtn.onclick = doSubmit;
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); doSubmit(); }
      if (e.key === 'Escape') { dismissAnnotationUI(); }
      // If user types, kill speech recognition
      if (speechRec && e.key.length === 1) {
        try { speechRec.abort(); } catch(ex){} speechRec = null;
        const dot = pop.querySelector('.mic-pulse-dot');
        if (dot) dot.style.display = 'none';
      }
    });
  }

  function startSpeechRecognition(input, pop) {
    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRec) return;
    speechRec = new SpeechRec();
    speechRec.lang = 'en-GB';
    speechRec.continuous = false;
    speechRec.interimResults = true;
    const dot = pop.querySelector('.mic-pulse-dot');
    if (dot) dot.style.display = 'inline-block';
    speechRec.onresult = function(ev) {
      let transcript = '';
      for (let i = 0; i < ev.results.length; i++) {
        transcript += ev.results[i][0].transcript;
      }
      if (transcript) input.value = transcript;
    };
    speechRec.onend = function() {
      if (dot) dot.style.display = 'none';
      speechRec = null;
    };
    speechRec.onerror = function() {
      if (dot) dot.style.display = 'none';
      speechRec = null;
    };
    try { speechRec.start(); } catch(e) { speechRec = null; }
  }

  function getCharOffset(container, range) {
    const preRange = document.createRange();
    preRange.setStart(container, 0);
    preRange.setEnd(range.startContainer, range.startOffset);
    return preRange.toString().length;
  }

  async function submitAnnotation(quote, anchor_type, anchor_ref, comment) {
    const res = await fetch('/api/items/' + SLUG + '/annotate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ quote: quote, anchor_type: anchor_type, anchor_ref: anchor_ref, comment: comment })
    });
    if (res.ok) {
      const ann = await res.json();
      renderAnnotation(ann);
    }
  }

  async function deleteAnnotation(id) {
    await fetch('/api/items/' + SLUG + '/annotations/' + id, { method: 'DELETE' });
  }

  function escapeHtml(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // Close annotation UI on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') dismissAnnotationUI();
  });

  // Load annotations on page ready
  loadAnnotations();

  async function submitDecision(decision) {
    const feedback = (document.getElementById('feedbackInput') || document.getElementById('sidebarFeedback') || {}).value || '';
    const slug = '<%= item.slug %>';
    document.querySelectorAll('.btn-action').forEach(b => { b.disabled = true; b.style.opacity = '0.5'; });
    try {
      // Fetch inline annotations and bundle into feedback
      let fullFeedback = feedback;
      try {
        const annRes = await fetch('/api/items/' + slug + '/annotations');
        if (annRes.ok) {
          const annotations = await annRes.json();
          if (annotations.length > 0) {
            const annText = annotations.map(function(a) {
              if (a.anchor_type === 'image') return '• [Image ' + (a.anchor_ref || '') + '] → ' + a.comment;
              return '• "' + (a.quote || '').substring(0, 80) + (a.quote && a.quote.length > 80 ? '…' : '') + '" → ' + a.comment;
            }).join('\n');
            fullFeedback = (fullFeedback ? fullFeedback + '\n\n' : '') + '--- Inline Annotations ---\n' + annText;
          }
        }
      } catch(e) { /* annotations fetch failed, proceed without */ }

      const res = await fetch('/api/items/' + slug + '/decide', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision, feedback: fullFeedback || undefined })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        const data = await res.json();
        if (window.showToast) window.showToast('Error: ' + (data.error || 'Unknown'), { error: true });
        else alert('Error: ' + (data.error || 'Unknown'));
        document.querySelectorAll('.btn-action').forEach(b => { b.disabled = false; b.style.opacity = '1'; });
      }
    } catch (err) {
      if (window.showToast) window.showToast('Network error', { error: true });
      else alert('Network error');
      document.querySelectorAll('.btn-action').forEach(b => { b.disabled = false; b.style.opacity = '1'; });
    }
  }

  async function retryDecisionAction() {
    const slug = '<%= item.slug %>';
    const button = document.querySelector('.approval-retry-btn');
    if (button) {
      button.disabled = true;
      button.textContent = 'Queued';
    }
    try {
      const res = await fetch('/api/items/' + slug + '/action/retry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      if (res.ok) {
        window.location.reload();
        return;
      }
      const data = await res.json();
      if (window.showToast) window.showToast('Retry failed: ' + (data.error || 'Unknown'), { error: true });
      else alert('Retry failed: ' + (data.error || 'Unknown'));
    } catch (err) {
      if (window.showToast) window.showToast('Network error', { error: true });
      else alert('Network error');
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Retry';
      }
    }
  }
</script>

<!-- DEBUG: template version marker -->
<div id="tmpl-debug" style="display:none;" data-version="chat-http-v1" data-has-chat="<%= reviewChatEnabled %>"></div>

<% if (reviewChatEnabled) { %>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="/chat.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 'dev' %>"></script>
<% } %>

PORT=3457
REVIEW_USER=reviewer
REVIEW_PASSWORD=changeme
SESSION_SECRET=change-me
TURF_REVIEW_BASE_URL=https://review.turfterrace.com
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
# OPENCLAW_GATEWAY_TOKEN also works when using the local OpenClaw gateway.
OPENCLAW_TOKEN=replace-me
OPENCLAW_AGENT_ID=main
CHAT_MODEL=openclaw/main
KITCHENLUX_CRM_DB_PATH=/absolute/path/to/crm.db
# Apple Push Notification service token credentials. Prefer a root-readable key file.
# TURF_REVIEW_APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
# TURF_REVIEW_APNS_KEY_ID=YOUR_APNS_KEY_ID
# TURF_REVIEW_APNS_PRIVATE_KEY_PATH=/secure/path/AuthKey_KEYID.p8
